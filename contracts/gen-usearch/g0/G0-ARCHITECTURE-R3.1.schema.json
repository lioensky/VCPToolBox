  "title": "Gen-USearch G0 R3.1 Architecture Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture_version",
    "contract_version",
    "gate",
    "status",
    "authority_planes",
    "clocks",
    "query_read_view_required_fields",
    "contracts",
