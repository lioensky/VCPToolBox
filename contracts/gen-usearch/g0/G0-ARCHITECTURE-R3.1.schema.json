    },
    "authority_planes": {
      "const": {
        "canonical_source": "content_authority",
        "sqlite": "identity_and_lifecycle_authority",
        "sqlite_manifest": "physical_topology_authority",
        "query_read_view_metadata": "logical_query_authority",
        "pinned_memtables_and_segments": "physical_candidate_sources",
        "tombstone_cache": "derived_rebuildable_state"
      }
    },
    "clocks": {
      "const": {
        "visibility_seq": "logical_visibility_order",
        "manifest_epoch": "physical_topology_order",
        "independence_required": true
      }
    },
    "query_read_view_required_fields": {
      "const": [
        "read_view_id",
        "visibility_seq",
        "metadata_snapshot",
        "manifest_snapshot",
        "memtable_generation_set",
        "runtime_fence",
        "created_at",
        "deadline"
      ]
    },
    "contracts": {
      "const": [
        {
          "id": "C1",
          "name": "Chunk Identity & Reconciliation",
          "authority": "identity planning only; no lifecycle mutation"
        },
        {
          "id": "C2",
          "name": "Document / Source Identity",
          "authority": "stable document identity and committed-source observation"
        },
        {
          "id": "C3",
          "name": "Vector Identity Allocation",
          "authority": "signed-int64-safe, durable monotonic, never reuse"
        },
        {
          "id": "C4",
          "name": "Vector MVCC & Current Head",
          "authority": "SQLite CAS is logical publication authority"
        },
        {
          "id": "C5",
          "name": "Metadata / Segment Integrity",
          "authority": "metadata and durable segment integrity"
        },
        {
          "id": "C6",
          "name": "Query / Flush / Compaction / GC",
          "authority": "snapshot correctness and physical/logical separation"
        },
        {
          "id": "C7",
          "name": "Runtime / Recovery / Ownership",
          "authority": "single serving owner, crash recovery and durable transaction fencing"
        },
        {
          "id": "C8",
          "name": "Engine Modes / Shadow Isolation",
          "authority": "legacy-shadow-active transition and no silent fallback"
        }
      ]
