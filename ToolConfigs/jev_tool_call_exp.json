        "vsearch": {
          "plugin": "VSearch",
          "aliases": ["vsearch", "v搜索", "默认搜索"],
          "fixedArgs": {
            "SearchMode": "grounding",
            "ShowURL": "false"
          }
        },
        "google": {
          "plugin": "SerpSearch",
          "aliases": ["google", "谷歌", "谷歌搜索"],
          "fixedArgs": {
            "command": "google_search"
          }
