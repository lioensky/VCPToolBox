        "bilibili_fetch": {
          "plugin": "BilibiliFetch",
          "aliases": ["b站获取", "b站视频", "哔哩哔哩", "bilibili"],
          "fixedArgs": {
            "need_subs": "true",
            "need_pbp": "true",
            "danmaku_num": "20",
            "comment_num": "20"
