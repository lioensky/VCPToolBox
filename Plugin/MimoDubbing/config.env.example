# 复制为同目录 config.env，密钥仅在后端读取。不要提交真实密钥。
MIMO_API_KEY=
MIMO_API_URL=https://www.dmxapi.cn/v1/chat/completions
MIMO_MODEL=mimo-v2.5-tts

# 官方 Key 应同时改用 https://api.xiaomimimo.com/v1/chat/completions
# /v1 基础地址也可，自动追加 /chat/completions

# 后台总超时（包含所有字幕的上游请求）
MIMO_TASK_TIMEOUT_MS=1800000
# overflow=fit 时的最高保音高加速倍率
MIMO_MAX_SPEED=2
# 只在 fit 且语音超过字幕窗口时需要 FFmpeg
MIMO_FFMPEG_PATH=ffmpeg

# 可选：完整公开基础 URL（含端口），默认使用 VarHttpUrl + SERVER_PORT
# MIMO_PUBLIC_BASE_URL=http://127.0.0.1:6005
# 可选：默认本机主服务端口；分布式部署必须填实际可访问主服务回调地址
# CALLBACK_BASE_URL=http://127.0.0.1:6005/plugin-callback

# 本地 SoVITS：调用时 engine=sovits。保留默认 MiMo，不要求填写 MIMO_API_KEY。
SOVITS_API_URL=
# 留空不发送 Authorization；公网服务应开启鉴权。
SOVITS_API_KEY=
# 推理器电脑上的真实绝对目录！不是后端目录、不是 HTTP/file URL；路径必须 ASCII。
# SOVITS_REFERENCE_DIR=H:/MCP/VCPChat/AppData/sovits5cpp/refs
SOVITS_REFERENCE_DIR=
# 只复制 VChat 的 presets.json 到本插件目录。可选覆盖本地 JSON 路径。
# SOVITS_PRESETS_PATH=
# SoVITS 的 WAV 统一转换为 24kHz 单声道 PCM16，须安装 FFmpeg，复用 MIMO_FFMPEG_PATH。