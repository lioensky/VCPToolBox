# Arxiv每日论文插件的Arxiv应用程序接口设置

# 针对Arxiv API的搜索查询语句
# 示例：全部:(“大语言模型”或“检索增强生成”)
ARXIV_SEARCH_TERMS='all:("Long-read Sequencing" OR "metagenome "OR "microbial genomics" OR "pathogen detection")'

# 从Arxiv API获取的结果数量
ARXIV_MAX_RESULTS=300

# 获取论文的天数范围（含今日）（例如：1代表仅今日，2代表今日及昨日）。
ARXIV_DAYS_RANGE=30

# 启用调试模式以生成更详细的日志记录。设置为 true 或 false。
ARXIV_DEBUG_MODE=false