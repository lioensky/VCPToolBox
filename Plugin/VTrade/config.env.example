# Optional local runtime directory. Leave empty to use Plugin/VTrade/data (ignored by Git).
VTRADE_DATA_DIR=
# Optional administrator-created JSON file with explicit local data sources and tool settings. No paths are accepted from AI calls.
VTRADE_SOURCES_FILE=
# Optional adapters from adapters/, comma-separated. Empty loads none. tencent-intraday uses an undocumented web API (personal study only).
VTRADE_ADAPTERS=
