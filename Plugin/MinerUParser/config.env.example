# MinerUParser 插件配置文件
# 复制为 config.env 并填入真实值（config.env 不会提交 Git）

# MinerU API Token（从 https://mineru.net 的 API 页面获取）
MINERU_TOKEN=

# 默认解析模型：vlm（MinerU 4.0 视觉大模型）/ pipeline（传统管线）
MODEL_VERSION=vlm

# parse / query 命令单次轮询等待上限（秒）；
# 超时后返回 batch_id，可反复 query 续查。
# 上限 1500 秒（配合 manifest 30 分钟总超时）
POLL_TIMEOUT_SEC=1500

# 批量解析/续查并发数（1-5，默认 3；请求里的 workers 参数优先）
BATCH_WORKERS=3
