# 可选：AnySearch API Key。不配置时匿名访问（额度较低）。
# 支持多个 Key 用英文逗号分隔，每次请求随机选用一个，例如：as_sk_xxx,as_sk_yyy
# 获取地址：https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=

# 可选：搜索 endpoint（默认 https://api.anysearch.com/v1/search）
# 普通搜索和批量搜索走这个 endpoint，返回结构化 JSON 便于结果裁剪。
ANYSEARCH_SEARCH_ENDPOINT=https://api.anysearch.com/v1/search

# 可选：MCP endpoint（默认 https://api.anysearch.com/mcp）
# get_sub_domains、extract 和维护同步走这个 endpoint。
ANYSEARCH_MCP_ENDPOINT=https://api.anysearch.com/mcp

# 可选：兼容别名，等同于 ANYSEARCH_MCP_ENDPOINT。新配置建议用 ANYSEARCH_MCP_ENDPOINT。
# ANYSEARCH_ENDPOINT=https://api.anysearch.com/mcp

# 可选：HTTP 请求超时，单位毫秒，范围 1000-40000（默认 30000）
# VCP 宿主超时为 45000ms，内部上限为进程清理保留余量。
ANYSEARCH_TIMEOUT_MS=30000
