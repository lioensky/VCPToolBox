# Gemini Image Generation Plugin Configuration

# 在此处填入您的 Gemini API 密钥，可以填入多个，用英文逗号隔开。
# 插件会从中随机选择一个使用。
GeminiImageKey=key1,key2,key3

# 如果您需要通过代理访问 Gemini API，请在此处设置您的代理地址。
# 例如：http://127.0.0.1:7890
# 如果不需要代理，请将此行留空或注释掉。
GeminiImageProxy=

# 可选 - 是否使用公网地址返回图片/文件 URL（true=VarHttpsUrl 不带端口，false=VarHttpUrl:端口，默认 false）
USE_PUBLIC_URL=false
