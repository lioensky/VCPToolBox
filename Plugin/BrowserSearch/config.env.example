# BrowserSearch 插件配置模板
# 复制为 config.env 后生效；依赖根配置 VCP_BROWSER_RUNTIME_ENABLED=true

# 默认搜索引擎：auto / google / baidu / bing / bing_cn / bing_global
BROWSER_SEARCH_DEFAULT_ENGINE=auto

# 每个查询默认提取的自然结果数量（1-30）
BROWSER_SEARCH_MAX_RESULTS=10

# 一次批量调用允许的最大查询数量（1-20）
BROWSER_SEARCH_MAX_BATCH_QUERIES=6

# 内存缓存有效期（毫秒）；0 表示关闭缓存
BROWSER_SEARCH_CACHE_TTL_MS=120000

# 同一引擎单查询导航的最小间隔（毫秒）
BROWSER_SEARCH_MIN_INTERVAL_MS=1500

# 批量导航错峰间隔（毫秒）；页面加载仍会重叠进行
BROWSER_SEARCH_BATCH_LAUNCH_INTERVAL_MS=600

# 页面加载后等待动态 SERP 渲染的时间（毫秒）
BROWSER_SEARCH_RENDER_WAIT_MS=1800

# 提取完成后是否默认关闭本次搜索标签页
# 服务器长期运行或频繁批量搜索时建议设为 true
BROWSER_SEARCH_CLOSE_TAB_AFTER_SEARCH=false

# 调试日志
DebugMode=false