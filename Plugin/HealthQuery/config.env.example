# Copy to config.env for local use. Do not commit config.env or tokens.json.

# Required Fitbit OAuth application credentials from https://dev.fitbit.com/apps.
CLIENT_ID=
CLIENT_SECRET=

# Must match the redirect URI registered in the Fitbit developer console.
REDIRECT_URI=http://localhost:8129/

# Local OAuth token file name or absolute path.
TOKEN_FILE=tokens.json

# Keep logs off by default because health data is sensitive.
DEBUG_MODE=false
FITBIT_REQUEST_TIMEOUT_SECONDS=20

# Daily summary fields.
RETURN_DAILY_DATE=true
RETURN_DAILY_STEPS=true
RETURN_DAILY_CALORIES_OUT=true
RETURN_DAILY_RESTING_HEART_RATE=true
RETURN_DAILY_DISTANCE=true
RETURN_DAILY_FLOORS=true
RETURN_DAILY_ACTIVE_MINUTES=true
RETURN_DAILY_ACTIVE_MINUTES_VERY=true
RETURN_DAILY_ACTIVE_MINUTES_FAIRLY=true
RETURN_DAILY_ACTIVE_MINUTES_LIGHTLY=true
RETURN_DAILY_ACTIVE_MINUTES_SEDENTARY=false
RETURN_DAILY_GOALS_MET=true
RETURN_DAILY_RAW_SUMMARY=false

# Heart-rate response fields.
RETURN_HEART_DATE=true
RETURN_HEART_RESTING_HEART_RATE=true
RETURN_HEART_ZONES=true
RETURN_HEART_STATS=true
RETURN_HEART_INTRADAY_SAMPLES_HOURLY=false

# Sleep response fields.
RETURN_SLEEP_DATE=true
RETURN_SLEEP_TOTAL_MINUTES_ASLEEP=true
RETURN_SLEEP_TOTAL_TIME_IN_BED=true
RETURN_SLEEP_STAGES_BREAKDOWN=true
RETURN_SLEEP_STAGE_START_TIME=true
RETURN_SLEEP_STAGE_END_TIME=true
RETURN_SLEEP_STAGE_DURATION_MINUTES=true
RETURN_SLEEP_STAGE_EFFICIENCY=true
RETURN_SLEEP_STAGE_IS_MAIN_SLEEP=true
RETURN_SLEEP_STAGE_LEVELS_SUMMARY=true

# Data-quality thresholds.
MIN_VALID_DAILY_STEPS=1
MIN_VALID_CALORIES_OUT=1
MIN_VALID_DISTANCE=0.01
MIN_VALID_FLOORS=1
MIN_VALID_RESTING_HEART_RATE=30
MAX_VALID_RESTING_HEART_RATE=220
MIN_VALID_SLEEP_TOTAL_MINUTES=20
MIN_VALID_SLEEP_STAGE_MINUTES=20
MIN_VALID_SLEEP_STAGE_LEVEL_MINUTES=20
