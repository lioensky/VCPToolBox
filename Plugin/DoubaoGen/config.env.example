# 火山引擎 API 密钥
# 从 https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey 获取
# 支持多个API密钥，用英文逗号分隔，系统会顺序轮询使用
# 如果某个密钥配额用完，会自动尝试其他密钥
# 示例：VOLCENGINE_API_KEY=key1,key2,key3
VOLCENGINE_API_KEY=your_api_key_here

# 自定义 API 请求地址（核心：支持直接走火山引擎订阅/套餐计划链接，或第三方中转代理）
# 标准按量端点: https://ark.cn-beijing.volces.com/api/v3/images/generations
# 订阅套餐端点: https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
# 如果填写此项，将优先直接请求此完整 URL
VOLCENGINE_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations

# 是否开启订阅计划路径（当未填写 VOLCENGINE_API_URL 时生效）
# true: 走 /api/plan/v3/images/generations
# false: 走 /api/v3/images/generations
USE_PLAN_API=true

# 默认模型ID（可通过 list_models 命令动态查询可用模型）
# 订阅计划模型如：doubao-seedream-5.0-lite
# 标准按量模型如：doubao-seedream-5-0-260128
SEEDREAM_MODEL_ID=doubao-seedream-5.0-lite

# 默认分辨率（支持 2K, 4K, 1K 或 1024x1024, 1280x720, adaptive 等）
DEFAULT_RESOLUTION=2K

# 图片输出格式 (png / jpeg)
DEFAULT_OUTPUT_FORMAT=png

# 是否默认添加水印 (true/false)
DEFAULT_WATERMARK=false

# 是否默认向大模型返回 Base64 图片数据 (true/false)
# false (推荐): 仅返回图片可访问URL及HTML渲染标签，大幅减少 Token 消耗，防止大模型上下文溢出；
# true: 额外注入 Base64 数据让多模态大模型可直接审视图片内容。
# 也可以在工具调用中通过 showbase64: true 临时按需开启。
DEFAULT_SHOW_BASE64=false

# 默认返回格式 (url 或 b64_json，兼容旧参数)
DEFAULT_RESPONSE_FORMAT=b64_json

# 调试模式 (true/false)
DebugMode=false
