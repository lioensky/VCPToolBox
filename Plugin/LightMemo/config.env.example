# LightMemo Configuration
#
# 生产检索构型由工具参数选择：
# - rivermemo：Rust/Rayon Topology V3（默认）
# - tagmemo：标准 TagMemo V9
# - knn：向量/BM25 混合检索
# TagMemoAB 会在同一权限候选域中比较 KNN、TagMemo V9、完全 Rust 一体
# RiverMemo，并可增加独立 Rerank / Jev 轨道。本文件不包含 V10 实验配置。

# 需要屏蔽、任何时候都不搜索的日记文件夹名称，用逗号分隔。
# 例如: EXCLUDED_FOLDERS=已整理,夜伽,MusicDiary,SomeOtherFolder
EXCLUDED_FOLDERS=已整理,夜伽,MusicDiary

# 外部 Rerank 服务。普通检索显式传 rerank 时才启用；
# TagMemoAB 的 Rerank 轨道会在未配置时明确标记不可用。
# 普通检索和 AB 轨道都只向外部服务提交 2×K 个候选。
RerankUrl=
RerankApi=
RerankModel=

# 单次最多提交 25 个候选，代码硬上限为 25。
# 普通记忆、TDB 冷知识检索和 TagMemoAB 共用这些批处理限制。
RerankMaxDocumentsPerRequest=25

# 小批量请求最大并发数，代码限制范围为 1~10。
RerankMaxConcurrentRequests=3

# 候选数或估算 Token 任一达到限制时即拆分批次。
RerankMaxTokensPerBatch=30000

# Jev 连接、密钥、供应商和可选代理统一读取根 config.env 的 JEV_*。
# 普通检索用 jev=true / jev=rrf / jev=rrf0.7 显式启用；
# TagMemoAB 用 compare_jev=true 增加独立 Jev 对照轨道。
# Jev 与传统 Rerank 一样只消费 2×K 候选；Choice 另受 255 硬上限约束。
JevRerankPrompt=请选择最值得用于回答当前查询的记忆。请综合考虑逻辑关联、记忆叙事连续性与信息解释力；优先选择能直接回答问题、补足关键背景或维持事件连续性的内容，压低表面词汇重合、重复、跑题或缺乏上下文价值的内容。
JevRerankMaxChoices=255
JevRerankMaxDocumentChars=6000

# AIMemo+ 无需在 LightMemo 中重复配置。
# aimemo=true 或 aimemo_preset=预设名时，通过 AIMemoBridge 复用
# Plugin/RAGDiaryPlugin/config.env 中的模型、API、提示词、缓存及预设。