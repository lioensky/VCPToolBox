# 扫描根目录；相对路径以 VCPToolBox 根目录为基准。
PLACEHOLDER_SCAN_ROOT=.

# 可选扫描源覆盖。
PLACEHOLDER_ENV_FILE=config.env
PLACEHOLDER_SAR_FILE=sarprompt.json
PLACEHOLDER_TVS_DIR=TVStxt
PLACEHOLDER_AGENT_DIR=Agent
PLACEHOLDER_PLUGIN_DIR=Plugin
PLACEHOLDER_IMAGE_DIR=image
PLACEHOLDER_AGENT_MAP_FILE=agent_map.json
PLACEHOLDER_TOOLBOX_MAP_FILE=toolbox_map.json

# 索引文件相对 PlaceholderExplorer 插件目录。
PLACEHOLDER_INDEX_FILE=generated/placeholder-index.json
PLACEHOLDER_MAX_SCAN_FILES=20000

# 编辑安全配置。备份目录必须位于 PlaceholderExplorer 插件目录内。
PLACEHOLDER_BACKUP_DIR=backups
PLACEHOLDER_BACKUP_RETENTION=20
PLACEHOLDER_MAX_EDIT_BYTES=1048576
