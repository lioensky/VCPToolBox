# LdBook 插件配置示例文件
# 复制此文件为 config.env 或在根目录中配置即可生效

# 网络代理 (支持 HTTP / SOCKS5 代理，例如 http://127.0.0.1:7890 或 http://127.0.0.1:10808)
# 如果留空，则自动读取系统的 HTTP_PROXY / HTTPS_PROXY，若都无则直连
HTTP_PROXY=

# 检索镜像站列表 (以英文逗号分隔)
# 若某些站点倒闭或失效，直接在此修改或新增，无需修改源码或重新编译！
SEARCH_MIRRORS=https://libgen.li,https://libgen.is,https://libgen.rs,https://libgen.st

# 下载网关列表 (以英文逗号分隔，按优先级解析)
DOWNLOAD_GATEWAYS=https://library.lol,http://library.lol

# 并发下载分片连接数 (推荐 2 ~ 4，避免触发网关限流)
DOWNLOAD_CONNECTIONS=3

# 单分块下载失败最大重试次数 (应对网络抖动)
DOWNLOAD_MAX_RETRIES=5

# 伪装 User-Agent 请求头
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
