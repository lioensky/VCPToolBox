# LinuxShellExecutor 配置
# ================================
# 说明：v2 执行路径使用 TaskStore 哨兵 + 统一 Markdown 输出；
#       旧版沙箱/RLIMIT 配置已停用，保留在文件末尾供参考。

# === 黑名单 ===
# 完全禁止的命令模式（正则表达式，逗号分隔）
FORBIDDEN_PATTERNS=rm\s+-rf\s+/,rm\s+-rf\s+/\*,mkfs\.,dd\s+if=,:\(\)\{\s*:\|:&\s*\};:,chmod\s+777\s+/,chmod\s+-R\s+777,>\s*/dev/sd,cat\s+/dev/zero\s*>\s*/dev/sd,wget.*\|.*sh,curl.*\|.*sh

# 完全禁止的命令（精确匹配，逗号分隔）
FORBIDDEN_COMMANDS=poweroff,halt,init 0,init 6,reboot -f,shutdown

# === 审计 ===
# 审计日志目录；相对路径基于 VCP 进程的工作目录
AUDIT_LOG_DIR=./logs/audit

# 安全事件告警 Webhook（可选）
# ALERT_WEBHOOK=https://your-webhook-url/alerts

# 5 分钟内的失败次数阈值
ALERT_THRESHOLD=5

# === 执行与输出 ===
# 默认同步等待阈值（毫秒），实际会被限制在 1000-55000；单次调用可用 timeout 覆盖
TIMEOUT_MS=30000

# 单次输出最大行数 / 字节数（v2 Markdown 输出）
MAX_OUTPUT_LINES=100
MAX_OUTPUT_SIZE=1048576

# === 安全级别 ===
# basic | standard | high | maximum
DEFAULT_SECURITY_LEVEL=standard

# === 授权验证 ===
# 由 VCP 主进程在 requiresAdmin=true 时自动注入，不要在文件中写死
# DECRYPTED_AUTH_CODE=

# 旧版沙箱 / RLIMIT 已从 v2 执行路径移除。
# 如需强隔离，请在主机或容器层部署。
