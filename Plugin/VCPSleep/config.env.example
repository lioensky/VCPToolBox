# ===================================================================
# VCPSleep 打盹小枕头配置
# ===================================================================

# 是否由 VCP 主进程向前端发送入睡、醒来、失败、超时的 VCPInfo 即时通知。
# 该通知不依赖 VCPSleep 子进程；即使同步插件退出或被超时终止，主进程仍可发送结束状态。
# 默认开启；不希望前端显示睡眠状态时设为 false。
VCPSLEEP_VCPINFO_ENABLED=true

# 是否允许睡觉时联动 AgentDream 尝试做一次梦。
# 默认关闭。只有当 AgentDream 插件也已由用户手动启用时才可能做梦；
# AgentDream 保持禁用时会安静跳过，不影响 VCPSleep 正常睡觉与醒来。
VCPSLEEP_DREAM_ENABLED=false

# VCPSleep 自己的额外入梦概率，范围 0-1。
# 1 表示不在 VCPSleep 这一层拦截；之后仍必须通过 AgentDream 自身的
# Agent 白名单、做梦时间窗口、DREAM_FREQUENCY_HOURS 冷却与
# DREAM_PROBABILITY 概率判定，因此此值不会覆盖 AgentDream 的设置。
VCPSLEEP_DREAM_PROBABILITY=1