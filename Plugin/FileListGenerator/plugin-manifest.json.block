{
  "manifestVersion": "1.0.0",
  "name": "FileListGenerator",
  "version": "1.0.0",
  "displayName": "文件列表生成器",
  "description": "生成 'file' 目录下的文件和文件夹列表，并提供给 {{VCPFileServer}} 占位符。",
  "author": "Kilo Code",
  "pluginType": "static",
  "entryPoint": {
    "type": "command",
    "command": "node file-list-generator.js"
  },
  "communication": {
    "protocol": "stdio",
    "timeout": 30000
  },
  "refreshIntervalCron": "*/5 * * * *",
  "configSchema": {
    "USE_PUBLIC_URL": {
      "type": "string",
      "description": "（可选）是否使用公网地址返回图片/文件 URL：true=使用 VarHttpsUrl（不带端口，适用于反代），false=使用 VarHttpUrl:端口（局域网），默认 false",
      "default": "false"
    }
  },
  "capabilities": {
    "systemPromptPlaceholders": [
      {
        "placeholder": "{{VCPFileServer}}",
        "description": "提供 'file' 目录的详细文件列表。"
      }
    ]
  }
}