# SkillBridge 顶层提示词，会作为 0.0 阈值区块的内容输出
SKILLBRIDGE_HEADER_TEXT=这里是Skill技能目录，若你需要对应技能，可直接引用下方折叠块中已展开的技能正文；如需按需深读完整技能文件，可用 ServerFileOperator 的 ReadFile 命令（filePath 填下方 Linux 绝对路径），或用 LinuxShellExecutor（cat/less 等）直接读取。

# 所有 Skill 索引区块默认使用的全局阈值
SKILLBRIDGE_DEFAULT_THRESHOLD=0.35

# 路径输出模式：
# auto = 自动跟随运行平台（Linux→linux 绝对路径，Windows→absolute_windows）
# linux = Linux 真实绝对路径（正斜杠，如 /opt/VCPToolBox/Plugin/SkillBridge/SKILL/xx/SKILL.md）
# relative = 相对 Plugin/SkillBridge/ 的路径（正斜杠）
# absolute_windows = Windows 真实绝对路径（反斜杠，兼容旧 Windows 部署）
SKILLBRIDGE_PATH_MODE=linux