# CrossRef每日文献插件的CrossRef API设置

# CrossRef API的文献书目查询
# 示例: "Long-read Sequencing" OR metagenome OR "microbial genomics" OR "pathogen detection"
CROSSREF_QUERY_BIBLIOGRAPHIC='"Long-read Sequencing" OR metagenome OR "microbial genomics" OR "pathogen detection"'

# 从CrossRef API获取的结果数量。
CROSSREF_ROWS=300

# 获取文献的天数（含今日）（例如：1代表仅今日，2代表今日及昨日）。
# 若未指定，默认值为1。
CROSSREF_DAYS_RANGE=2

# 启用调试模式以生成更详细的日志记录。设置为 true 或 false。
# 若设为 false，数据获取与处理过程中的部分非关键性错误将不会在日志中显示。
CROSSREF_DEBUG_MODE=false 