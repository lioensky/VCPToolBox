# 运行模式：disabled=不启动；probe=只检查连接；enabled=正式接收 Telegram 消息
TELEGRAM_MODE=disabled

# Telegram BotFather 提供的 Bot Token（不要发到聊天或提交 Git）
TELEGRAM_BOT_TOKEN=

# 允许使用机器人的 Telegram 用户 ID，多个用英文逗号分隔
TELEGRAM_ALLOWED_USER_IDS=

# 允许的群聊 ID，多个用英文逗号分隔；不用群聊可留空
TELEGRAM_ALLOWED_CHAT_IDS=

# 是否启用群聊；首次使用建议保持 false
TELEGRAM_GROUPS_ENABLED=false

# 默认 Agent，以及 Telegram 中允许切换的 Agent
TELEGRAM_DEFAULT_AGENT=ExampleAgent
TELEGRAM_ALLOWED_AGENTS=ExampleAgent

# Telegram 长轮询：单次等待秒数和每批更新数量
TELEGRAM_POLL_TIMEOUT_SEC=30
TELEGRAM_UPDATE_LIMIT=50

# 并发和排队限制，一般保持默认即可
TELEGRAM_MAX_CONCURRENT_SCOPES=3
TELEGRAM_MAX_QUEUED_TOTAL=100
TELEGRAM_MAX_QUEUED_PER_SCOPE=20

# 收发文件最大字节数，一般保持默认即可
TELEGRAM_MAX_INBOUND_BYTES=19922944
TELEGRAM_MAX_OUTBOUND_BYTES=47185920

# 外部文件下载的 DNS：system=系统默认；cloudflare=插件专用加密 DNS（兼容代理 Fake-IP）
# cloudflare 只发送目标域名，不发送资源路径/文件；不影响 Telegram/VCP 连接，仍拒绝内网地址
TELEGRAM_OUTBOUND_DNS=system

# 每个会话保留的历史消息数和最大字节数
TELEGRAM_HISTORY_MAX_MESSAGES=40
TELEGRAM_HISTORY_MAX_BYTES=262144

# 插件状态目录；留空时使用插件目录下的 state
TELEGRAM_STATE_DIR=

# 本机 VCP 接口、模型名称和 VCP server key
TELEGRAM_VCP_BASE_URL=http://127.0.0.1:6005/v1
TELEGRAM_VCP_MODEL=VCPModelAuto
# 可按 Agent 对齐本地使用的模型；未列出的 Agent 使用上面的默认模型
TELEGRAM_AGENT_MODELS={}
# 留空保持上游默认；按需要与本地客户端对齐（例如 0.7 / 60000）
TELEGRAM_VCP_TEMPERATURE=
TELEGRAM_VCP_MAX_TOKENS=
TELEGRAM_VCP_KEY=

# 流式显示方式：draft=私聊草稿；edit=编辑消息
TELEGRAM_STREAM_MODE=draft

# 是否允许无原始请求关联的主动消息；建议保持 false
TELEGRAM_PROACTIVE_ENABLED=false

# 是否记录消息正文；为保护隐私必须保持 false
TELEGRAM_LOG_CONTENT=false
