# 复制为同目录 config.env 后填写密钥；不要提交真实密钥。
# 支持多个 Key，用英文逗号或 | 分隔，每次请求随机选择一个。
# 示例：YouSearchKey=key-one,key-two 或 YouSearchKey=key-one|key-two
# 自动忽略空项、首尾空白及重复 Key；随机分配不保证避免 RPM 限流。
YouSearchKey=

# 可选：完整 Research API 端点，也可填写兼容的 API 中转地址。
YouSearchUrl=https://api.you.com/v1/research

# 仅支持 lite / standard / deep，单次调用 research_effort 优先。
YouSearchEffort=standard

# 毫秒，deep 建议 >=180000，实际最多为清单超时减去 15000。
YouSearchTimeout=240000

# 可选 HTTP(S) 网络代理；留空直连，不自动继承 HTTP_PROXY/HTTPS_PROXY。
# 示例：http://127.0.0.1:7890 或 http://user:password@127.0.0.1:7890
YouSearchProxy=