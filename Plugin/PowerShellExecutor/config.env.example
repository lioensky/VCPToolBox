# ServerPowerShellExecutor Plugin Configuration
# Version: 1.1.0

# --- 返回模式 ---
# 定义命令输出的默认返回行为。
# - "delta": 仅返回最近执行的命令输出。（默认，推荐）
# - "full": 返回完整的终端缓冲区内容。
POWERSHELL_RETURN_MODE=delta

# --- 完全禁止的指令 ---
# 列出完全禁止的指令中的关键字。
# 注意：v1.1.0 使用智能检查机制（intelligentSecurityCheck），能够区分命令关键字和路径内容。
# 例如：路径 "H:\Down\APK\platform-tools-latest-windows\platform-tools" 中的 "rm" 不会被误判。
# 只有当关键字作为独立的命令或参数出现时才会被阻止。
# 请用英文逗号 "," 分隔多个关键字。
FORBIDDEN_COMMANDS=rm,del,rmdir

# --- 需要管理员授权的指令 ---
# 列出需要管理员验证码 (tool_password) 才能执行的指令中的关键字。
# 注意：智能检查机制同样适用于授权检查，路径中的关键字不会触发授权要求。
# 只有当关键字作为独立的命令或参数出现时才需要授权。
# 请用英文逗号 "," 分隔多个关键字。
AUTH_REQUIRED_COMMANDS=net,shutdown,restart,Set-Item,Set-Content,Add-Content,Clear-Content

# --- 诊断模式 ---
# 当命令执行失败且无输出时，是否在错误返回中附带诊断信息（Shell路径、临时脚本路径等）。
# 默认开启。关闭可设为 false。
VERBOSE_ERROR=true