# 文件操作插件配置模板
# 将此文件复制为.env文件，并根据需要修改其中的参数值

# 安全设置 - 定义文件操作允许访问的目录
# 使用绝对路径，多个路径之间用逗号分隔
# 留空则允许访问所有目录（生产环境**不推荐**）
ALLOWED_DIRECTORIES=F:/VCP,F:/Wan2GP

# 操作允许的最大文件大小（单位：字节）
# 10MB = 10 * 1024 * 1024 = 10485760
# 50MB = 52428800
MAX_FILE_SIZE=20485760

# 目录列表中可返回的最大文件数量
MAX_DIRECTORY_ITEMS=1000

# 搜索结果最大数量
MAX_SEARCH_RESULTS=100

# 启用调试日志记录（true/false）
DEBUG_MODE=true

# 用于推送通知的WebSocket设置（若已启用）
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=6573

# 文件操作设置
ENABLE_RECURSIVE_OPERATIONS=true
ENABLE_HIDDEN_FILES=false

# 备份设置（可选）
CREATE_BACKUPS=true
BACKUP_DIRECTORY=F:/VCP/VCP新手启动包/用户配置备份


# 其他安全选项
# REQUIRE_CONFIRMATION=false  # 对破坏性操作需进行确认
LOG_ALL_OPERATIONS=true     # 将所有文件操作记录到文件中
