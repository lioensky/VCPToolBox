# Copy to config.env for local use. Never commit config.env or Cookie files.

# Inline cookie (optional; must include SESSDATA for login-only actions).
BILIBILI_COOKIE=

# Preferred alternative: path to a local Netscape Cookie export.
BILIBILI_COOKIE_FILE=

# Optional account MID. The plugin can usually infer it from the login state.
BILIBILI_MID=

# Optional bounded timeouts and enrichment settings.
# SYNBILIVISION_TIMEOUT_MS=105000
# SYNBILIVISION_REQUEST_TIMEOUT_MS=12000
# SYNBILIVISION_SUBTITLE_TIMEOUT_MS=6000
# SYNBILIVISION_HISTORY_ENRICH=2
