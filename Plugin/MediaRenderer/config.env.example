# MediaRenderer 当前无需第三方 API Key。
# PROJECT_BASE_PATH、SERVER_PORT、IMAGESERVER_IMAGE_KEY、VarHttpUrl
# 均由 VCP 的 PluginManager 自动注入。

# 是否输出逐步渲染诊断日志。
DebugMode=false

# 本插件依赖根配置启用托管浏览器运行时：
# VCP_BROWSER_RUNTIME_ENABLED=true
#
# 插件不会调用 ChromeBridge，而是通过 browserRuntimeManager 获取
# DevTools WebSocket Endpoint，并使用 Puppeteer/CDP 创建独立浏览器上下文。
#
# 当前支持：
# - 64x64 至 4096x4096 静态 PNG / JPG / WebP
# - 确定性逐帧 GIF / MP4 / WebM
# - HTML / SVG、透明 PNG/GIF/WebM
# - 内置 Anime.js 3.2.2 与 Three.js r160
# - data:、file://、HTTP/HTTPS 图片、音频、字体及二进制素材
# - 最多 16 步串行批量渲染
#
# 是否允许显式 assets 参数访问 localhost、局域网和私网 HTTP/HTTPS 素材。
# 云元数据地址即使开启此项仍会被阻断。
AllowPrivateNetworkAssets=true
#
# 系统 FFmpeg 命令或绝对路径。
FfmpegPath=ffmpeg
#
# 单次 FFmpeg 编码超时，10000-600000ms。
FfmpegTimeoutMs=180000
#
# 每个动画任务最大总帧数，1-3600；默认 600。
MaxAnimationFrames=600