# MediaRenderer 当前无需第三方 API Key。
# PROJECT_BASE_PATH、SERVER_PORT、IMAGESERVER_IMAGE_KEY、VarHttpUrl
# 均由 VCP 的 PluginManager 自动注入。

# 是否输出逐步渲染诊断日志。
DebugMode=false

# 本插件依赖根配置启用托管浏览器运行时：
# VCP_BROWSER_RUNTIME_ENABLED=true
#
# 插件不会调用 ChromeBridge，而是通过 browserRuntimeManager 获取
# DevTools WebSocket Endpoint，并使用 Puppeteer/CDP 创建独立浏览器上下文。
#
# 当前支持：
# - 64x64 至 4096x4096 静态 PNG / JPG / WebP
# - 确定性逐帧 GIF / MP4 / WebM
# - HTML / SVG、透明 PNG/GIF/WebM
# - 源码直接引用 data:、file://、HTTP/HTTPS 图片、视频和字体
# - Anime.js 3.2.2 与 Three.js r160 常见 CDN 标签自动改用本地版本
# - audioUrl 直接混入 MP4/WebM 音轨
# - 最多 16 步串行批量渲染
#
# 是否允许源码直引资源、audioUrl、sourceImage 和兼容 assets 参数
# 访问 localhost、局域网和私网 HTTP/HTTPS 地址。
# 所有远程重定向都会逐跳校验；云元数据地址即使开启此项仍会被阻断。
AllowPrivateNetworkAssets=true
#
# GIF / MP4 / WebM 编码所用的系统 FFmpeg 命令或绝对路径。
# 只生成 PNG / JPG / WebP 时不需要 FFmpeg。
FfmpegPath=ffmpeg
#
# 将逐帧 PNG 编码为 GIF / MP4 / WebM 的单次超时，10000-600000ms。
FfmpegTimeoutMs=180000
#
# 每个 GIF / 视频任务最大总帧数，1-3600；默认 600。
# 实际帧数 = ceil(durationMs * fps / 1000)。
MaxAnimationFrames=600